# Copy this file to .env before running Docker Compose.
# Never commit real API keys.

# Qdrant vector store
QDRANT_COLLECTION=rag_documents
RETRIEVAL_TOP_K=7
RETRIEVAL_SEARCH_TYPE=similarity
RETRIEVAL_FETCH_K=50
RETRIEVAL_LAMBDA_MULT=0.3

# Shared exact-answer cache
REDIS_URL=redis://redis:6379/0
ANSWER_CACHE_TTL_SECONDS=3600

# Ollama runs on the host in deployment option A.
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text

# OpenAI-compatible chat model
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL_ID=kimi-k2.6
LLM_THINKING_TYPE=disabled

# Configure one compatible API key.
MOONSHOT_API_KEY=your_api_key_here
OPENAI_API_KEY=
