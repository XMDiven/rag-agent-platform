# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_documents
RETRIEVAL_TOP_K=7
# Default is similarity; set to mmr to opt into diversity (costs ranking quality, see experiments/retrieval_baseline_2026-06-05.md)
RETRIEVAL_SEARCH_TYPE=similarity
# Only used when RETRIEVAL_SEARCH_TYPE=mmr
RETRIEVAL_FETCH_K=50
RETRIEVAL_LAMBDA_MULT=0.3

# Optional shared exact-answer cache. Leave REDIS_URL unset to disable it.
REDIS_URL=redis://localhost:6379/0
ANSWER_CACHE_TTL_SECONDS=3600

# Embedding model service
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# Chat model service
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL_ID=kimi-k2.6
LLM_THINKING_TYPE=disabled
# 上游调用超时；不设会无限等待并耗尽 FastAPI 线程池。
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
EMBEDDING_TIMEOUT_SECONDS=30

# Use one compatible API key. Do not commit real secrets.
MOONSHOT_API_KEY=your_api_key_here
# OPENAI_API_KEY=your_api_key_here
